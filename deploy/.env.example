# =============================================================================
# GuiCang 部署环境变量模板（复制为 .env 并填写；敏感值不进 git）
# 生成：bash scripts/setup.sh（自动生成密钥与随机密码）
# =============================================================================

# 数据库：sqlite（默认）| postgresql（需先起 postgres 服务）
GUICANG_DB_PROFILE=sqlite

# JWT 密钥（≥32 字节随机串，由 setup.sh 生成）
GUICANG_JWT_SECRET=

# Redis 密码（由 setup.sh 生成随机值）
GUICANG_REDIS_PASSWORD=

# PostgreSQL（切换 GUICANG_DB_PROFILE=postgresql 时使用）
GUICANG_POSTGRES_USER=guicang
GUICANG_POSTGRES_PASSWORD=

# 存储根（用户数据真源，bind 进容器 /nas）
GUICANG_STORAGE_ROOT=/home/wb/nas
