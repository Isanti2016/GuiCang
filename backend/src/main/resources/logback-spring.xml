<?xml version="1.0" encoding="UTF-8"?>
<!-- GuiCang 日志配置：控制台 + 标准文本滚动文件（应用自带，不依赖 ELK）
     文件目录：GUICANG_LOG_DIR 可覆盖（容器内 /var/log/guicang；本地默认 ./data/logs） -->
<configuration>
  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="guicang-backend"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${GUICANG_LOG_DIR:-./data/logs}/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${GUICANG_LOG_DIR:-./data/logs}/app-%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

  <logger name="com.guicang.nas" level="DEBUG"/>
</configuration>
